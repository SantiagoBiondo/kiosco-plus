<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KioscoRockAndRoll.Dominio\KioscoRockAndRoll.Dominio.csproj" />
    <ProjectReference Include="..\KioscoRockAndRoll.Datos\KioscoRockAndRoll.Datos.csproj" />
    <ProjectReference Include="..\KioscoRockAndRoll.Reportes\KioscoRockAndRoll.Reportes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- El símbolo de Kiosco+: el .exe lo usa como ícono y la ventana lo carga de acá. -->
    <EmbeddedResource Include="Recursos\KioscoPlus.ico" LogicalName="KioscoPlus.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Proyecto_Kiosco_Rock_Roll</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Datos del programa (se ven en Propiedades > Detalles del .exe). -->
  <PropertyGroup>
    <AssemblyName>KioscoPlus</AssemblyName>
    <Product>Kiosco+</Product>
    <AssemblyTitle>Kiosco+</AssemblyTitle>
    <Description>Kiosco+: ventas, inventario y caja para kioscos</Description>
    <ApplicationIcon>Recursos\KioscoPlus.ico</ApplicationIcon>
    <Version>1.5.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>